    "vitest": "^5.0.0",
    "wouter": "^3.3.5",
    "zod": "catalog:"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.1",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.1",
    "dexie": "^4.4.5",
    "react-router-dom": "^7.18.3",
    "xlsx": "npm:@e965/xlsx@^0.20.3"
  },
  "description": "Kiosk attendance scanning for a USB HID NFC reader. Web/PWA, Android and macOS from one React app.",
