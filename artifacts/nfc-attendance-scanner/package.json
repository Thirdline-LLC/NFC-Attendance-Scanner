    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "embla-carousel-react": "^8.6.0",
    "esbuild": "0.28.2",
    "fake-indexeddb": "^6.2.5",
    "framer-motion": "catalog:",
