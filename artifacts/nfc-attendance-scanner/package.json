{
  "name": "@workspace/nfc-attendance-scanner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "serve": "vite preview --config vite.config.ts",
    "build": "node scripts/build.mjs web",
    "build:native": "node scripts/build.mjs capacitor",
    "build:electron": "node scripts/build.mjs electron && node electron/build.mjs",
    "native:sync": "pnpm run build:native && cap sync android",
    "native:android": "pnpm run native:sync && cap open android",
    "native:ios": "pnpm run build:native && cap sync ios && cap open ios",
    "android:apk": "pnpm run native:sync && cd android && ./gradlew assembleDebug",
    "electron:dev": "node electron/dev.mjs",
    "electron:start": "pnpm run build:electron && electron .",
    "package:mac:dir": "pnpm run build:electron && electron-builder --mac dir",
    "package:mac": "pnpm run build:electron && electron-builder --mac dmg",
    "test": "vitest run --config vitest.config.ts",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "package:mac:both": "pnpm run build:electron && electron-builder --mac dmg --arm64 --x64",
    "package:mac:universal": "pnpm run build:electron && electron-builder --mac dmg --universal",
    "package:mac:signed": "pnpm run build:electron && electron-builder --mac dmg --config.mac.identity=\"$SJC_SIGNING_IDENTITY\" --config.mac.notarize=true",
    "verify:mac": "bash scripts/verify-mac-build.sh"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-accordion": "^1.2.4",
    "@radix-ui/react-alert-dialog": "^1.1.7",
    "@radix-ui/react-aspect-ratio": "^1.1.3",
    "@radix-ui/react-avatar": "^1.1.4",
    "@radix-ui/react-checkbox": "^1.1.5",
    "@radix-ui/react-collapsible": "^1.1.4",
    "@radix-ui/react-context-menu": "^2.2.7",
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-dropdown-menu": "^2.1.7",
    "@radix-ui/react-hover-card": "^1.1.7",
    "@radix-ui/react-label": "^2.1.3",
    "@radix-ui/react-menubar": "^1.1.7",
    "@radix-ui/react-navigation-menu": "^1.2.6",
    "@radix-ui/react-popover": "^1.1.7",
