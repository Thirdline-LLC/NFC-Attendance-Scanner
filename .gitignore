# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/
.cla_user/

# Claude Code worktrees (per-session isolation)
.claude/worktrees/

# ── Student data — NEVER commit. Master Key v1.0 §5.3.6 ──
# Real student UIDs, names and emails stay out of this repo.
# Synthetic fixtures only (04AA0000000001 …).
*.xlsx
*.xls
*.csv
.env
.env.*
/exports
exports/

# ── Signing material — NEVER commit ──
# An Android keystore, an Apple certificate or a provisioning profile in the
# repo is a key anyone with read access can ship software as this school with.
# Keep them in a password manager or the machine's keychain; see
# docs/android-packaging.md and docs/desktop-macos.md.
*.keystore
*.jks
*.p12
*.pfx
*.cer
*.certSigningRequest
*.mobileprovision
*.provisionprofile
keystore.properties
# electron-builder and Gradle both read credentials from the environment, and
# a stray .env is the usual way one ends up on disk.
.env.local
.env.signing

# ── Packaged output ──
# `dist/` above already covers dist/desktop (the .app and .dmg) and
# dist/public; this catches the Gradle outputs the android/.gitignore misses
# when a build is run from the repo root.
*.apk
*.aab
*.dmg
*.app.zip
